#!/usr/bin/env python3
"""Install or remove Timeline's Codex handlers without replacing other hooks."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import tempfile
from datetime import datetime, timezone
from pathlib import Path


EVENTS = (
    "SessionStart",
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse",
    "Stop",
    "SessionEnd",
)
MARKER = "# timeline"
LEGACY_MARKER = "# codex-timeline"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config",
        type=Path,
        default=Path.home() / ".codex" / "hooks.json",
        help="hooks.json to update (default: ~/.codex/hooks.json)",
    )
    parser.add_argument("--uninstall", action="store_true", help="remove Timeline handlers")
    return parser.parse_args()


def load_config(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open(encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return value


def is_ours(group: object) -> bool:
    if not isinstance(group, dict):
        return False
    handlers = group.get("hooks", [])
    return any(
        isinstance(handler, dict)
        and any(marker in str(handler.get("command", "")) for marker in (MARKER, LEGACY_MARKER))
        for handler in handlers
    )


def remove_existing(config: dict) -> None:
    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("the top-level 'hooks' value must be a JSON object")
    for event in list(hooks):
        groups = hooks[event]
        if isinstance(groups, list):
            hooks[event] = [group for group in groups if not is_ours(group)]
            if not hooks[event]:
                del hooks[event]


def install(config: dict, adapter: Path) -> None:
    remove_existing(config)
    hooks = config.setdefault("hooks", {})
    for event in EVENTS:
        command = f"{shlex.quote(str(adapter))} {shlex.quote(event)} {MARKER}"
        hooks.setdefault(event, []).append(
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": command,
                        "timeout": 30,
                    }
                ]
            }
        )


def write_atomic(path: Path, config: dict) -> Path | None:
    path.parent.mkdir(parents=True, exist_ok=True)
    backup = None
    if path.exists():
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
        backup = path.with_name(f"{path.name}.backup-{stamp}")
        shutil.copy2(path, backup)

    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(config, handle, indent=2)
            handle.write("\n")
        os.replace(temporary, path)
    except Exception:
        Path(temporary).unlink(missing_ok=True)
        raise
    return backup


def main() -> None:
    args = parse_args()
    config_path = args.config.expanduser().resolve()
    adapter = (Path(__file__).resolve().parent / "timeline-hook").resolve()
    config = load_config(config_path)
    if args.uninstall:
        remove_existing(config)
        action = "Removed Timeline hooks from"
    else:
        install(config, adapter)
        action = "Installed Timeline hooks in"
    backup = write_atomic(config_path, config)
    print(f"{action} {config_path}")
    if backup:
        print(f"Backup: {backup}")


if __name__ == "__main__":
    main()
