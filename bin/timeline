#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: timeline <command> [options]

Commands:
  sync            Import existing commits and the current project state
  start           Create a baseline snapshot for a session
  checkpoint      Record the current worktree if it changed
  list            Print the session timeline as TSV
  diff <sequence> Print the patch introduced by one event
  files <sequence> Print files changed by one event
  context <sequence> Print stored Codex context for one event
  pending-set     Remember the tool label for the next checkpoint
  flush           Checkpoint the pending tool, if any
  clear-pending   Forget the pending tool
  enable          Enable/resume recording in this repository
  disable         Disable recording in this repository
  status          Show effective recording status (enabled by default)
  sessions        List recorded timeline refs, newest first
  latest          Print the most recently updated timeline ref

Options:
  --repo <path>       Repository path (defaults to the current directory)
  --session <id>      Timeline session (defaults to "default")
  --codex-session <id> Codex task/session context stored with the snapshot
  --label <text>      Human-readable event label
  --event <name>      Lifecycle event name
  --tool <name>       Codex tool name
  --turn <id>         Codex turn id
  --tool-use <id>     Codex tool invocation id
EOF
}

die() {
  printf 'timeline: %s\n' "$*" >&2
  exit 1
}

command_name="${1:-}"
[[ -n "$command_name" ]] || { usage; exit 2; }
shift

repo_input="${TIMELINE_REPO:-${CODEX_TIMELINE_REPO:-$PWD}}"
session="${TIMELINE_SESSION:-${CODEX_TIMELINE_SESSION:-default}}"
codex_session=""
label=""
event_name=""
tool_name=""
turn_id=""
tool_use_id=""
sequence_arg=""

while (($#)); do
  case "$1" in
    --repo) repo_input="${2:?missing value for --repo}"; shift 2 ;;
    --session) session="${2:?missing value for --session}"; shift 2 ;;
    --codex-session) codex_session="${2:?missing value for --codex-session}"; shift 2 ;;
    --label) label="${2:?missing value for --label}"; shift 2 ;;
    --event) event_name="${2:?missing value for --event}"; shift 2 ;;
    --tool) tool_name="${2:?missing value for --tool}"; shift 2 ;;
    --turn) turn_id="${2:?missing value for --turn}"; shift 2 ;;
    --tool-use) tool_use_id="${2:?missing value for --tool-use}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --*) die "unknown option: $1" ;;
    *)
      [[ -z "$sequence_arg" ]] || die "unexpected argument: $1"
      sequence_arg="$1"
      shift
      ;;
  esac
done

if [[ "$command_name" == "sync" ]]; then
  session="project"
  label="${label:-existing project baseline}"
  event_name="${event_name:-manual-sync}"
fi

repo_root="$(git -C "$repo_input" rev-parse --show-toplevel 2>/dev/null)" || die "not inside a Git repository: $repo_input"
git_dir="$(git -C "$repo_root" rev-parse --absolute-git-dir)"

safe_session="$(printf '%s' "$session" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '-')"
safe_session="${safe_session#-}"
safe_session="${safe_session%-}"
[[ -n "$safe_session" ]] || safe_session="default"
safe_session="session-${safe_session}"
timeline_ref="refs/codex-timeline/$safe_session"
state_dir="$git_dir/codex-timeline/$safe_session"
pending_dir="$state_dir/pending"
pending_key="$(printf '%s' "${tool_use_id:-default}" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '-')"
pending_key="${pending_key#-}"
pending_key="${pending_key%-}"
[[ -n "$pending_key" ]] || pending_key="default"
pending_file="$pending_dir/$pending_key"
lock_dir="$git_dir/codex-timeline/locks/$safe_session"
lock_owned=false

git_at() {
  git -C "$repo_root" "$@"
}

one_line() {
  printf '%s' "$1" | tr '\r\n' '  ' | cut -c1-160
}

acquire_lock() {
  local attempt owner_pid
  mkdir -p "$(dirname "$lock_dir")"
  for attempt in $(seq 1 200); do
    if mkdir "$lock_dir" 2>/dev/null; then
      printf '%s\n' "$$" > "$lock_dir/pid"
      lock_owned=true
      return
    fi
    owner_pid="$(sed -n '1p' "$lock_dir/pid" 2>/dev/null || true)"
    if [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
      rm -f "$lock_dir/pid"
      rmdir "$lock_dir" 2>/dev/null || true
      continue
    fi
    sleep 0.025
  done
  die "timed out waiting for session lock: $session"
}

release_lock() {
  if [[ "$lock_owned" == true ]]; then
    rm -f "$lock_dir/pid"
    rmdir "$lock_dir" 2>/dev/null || true
    lock_owned=false
  fi
}

trap release_lock EXIT

snapshot_tree() {
  local snapshot_dir snapshot_index tree
  snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/codex-timeline.XXXXXX")"
  snapshot_index="$snapshot_dir/index"

  GIT_INDEX_FILE="$snapshot_index" git_at read-tree --empty
  GIT_INDEX_FILE="$snapshot_index" git_at add -A -- .
  tree="$(GIT_INDEX_FILE="$snapshot_index" git_at write-tree)"
  rm -f "$snapshot_index"
  rmdir "$snapshot_dir"
  printf '%s\n' "$tree"
}

make_commit() {
  local tree="$1" parent="${2:-}" subject="$3" seq="$4"
  local message commit
  subject="$(one_line "$subject")"
  message="timeline: $subject

Timeline-Session: $(one_line "${codex_session:-$session}")
Timeline-Ref: $safe_session
Timeline-Sequence: $seq
Timeline-Event: $(one_line "${event_name:-checkpoint}")
Timeline-Tool: $(one_line "${tool_name:-unknown}")
Timeline-Turn: $(one_line "${turn_id:-unknown}")
Timeline-Tool-Use: $(one_line "${tool_use_id:-unknown}")"

  if [[ -n "$parent" ]]; then
    commit="$(printf '%s\n' "$message" | \
      GIT_AUTHOR_NAME='Timeline' \
      GIT_AUTHOR_EMAIL='timeline@local' \
      GIT_COMMITTER_NAME='Timeline' \
      GIT_COMMITTER_EMAIL='timeline@local' \
      git_at commit-tree "$tree" -p "$parent")"
  else
    commit="$(printf '%s\n' "$message" | \
      GIT_AUTHOR_NAME='Timeline' \
      GIT_AUTHOR_EMAIL='timeline@local' \
      GIT_COMMITTER_NAME='Timeline' \
      GIT_COMMITTER_EMAIL='timeline@local' \
      git_at commit-tree "$tree")"
  fi
  printf '%s\n' "$commit"
}

start_timeline() {
  local tree commit head head_tree count existing first first_sequence
  if git_at show-ref --verify --quiet "$timeline_ref"; then
    existing="$(git_at rev-parse "$timeline_ref")"
    if [[ "$safe_session" == "session-project" && "$(git_at rev-list --count "$timeline_ref")" == "1" ]]; then
      first="$(git_at rev-list --reverse "$timeline_ref" | sed -n '1p')"
      first_sequence="$(git_at show -s --format=%B "$first" | sed -n -e 's/^Timeline-Sequence: //p' -e 's/^Codex-Timeline-Sequence: //p' | tail -n 1)"
      if [[ "$first_sequence" == "0" ]]; then
        # Migrate timelines created by older plugin versions that represented
        # an existing repository as one opaque baseline.
        head="$(git_at rev-parse --verify HEAD 2>/dev/null || true)"
        if [[ -n "$head" ]]; then
          tree="$(snapshot_tree)"
          head_tree="$(git_at show -s --format=%T "$head")"
          if [[ "$tree" == "$head_tree" ]]; then
            commit="$head"
          else
            count="$(git_at rev-list --count "$head")"
            commit="$(make_commit "$tree" "$head" "${label:-existing project baseline}" "$((count + 1))")"
          fi
          git_at update-ref "$timeline_ref" "$commit" "$existing"
          printf '%s\n' "$commit"
          return
        fi
      fi
    fi
    printf '%s\n' "$existing"
    return
  fi

  tree="$(snapshot_tree)"
  event_name="${event_name:-session-start}"

  # Existing repositories already have a reliable commit-level ordering. Use
  # that history as the beginning of the project timeline, then add a snapshot
  # only when the worktree contains uncommitted or untracked state.
  head="$(git_at rev-parse --verify HEAD 2>/dev/null || true)"
  if [[ "$safe_session" == "session-project" && -n "$head" ]]; then
    head_tree="$(git_at show -s --format=%T "$head")"
    if [[ "$tree" == "$head_tree" ]]; then
      commit="$head"
    else
      count="$(git_at rev-list --count "$head")"
      commit="$(make_commit "$tree" "$head" "${label:-existing project baseline}" "$((count + 1))")"
    fi
  else
    commit="$(make_commit "$tree" "" "${label:-baseline}" 0)"
  fi
  git_at update-ref "$timeline_ref" "$commit"
  mkdir -p "$state_dir"
  printf '%s\n' "$commit"
}

checkpoint() {
  local parent previous_tree tree count commit subject last_sequence
  if ! git_at show-ref --verify --quiet "$timeline_ref"; then
    start_timeline >/dev/null
    return
  fi

  parent="$(git_at rev-parse "$timeline_ref")"
  previous_tree="$(git_at show -s --format=%T "$parent")"
  tree="$(snapshot_tree)"
  if [[ "$tree" == "$previous_tree" ]]; then
    return
  fi

  last_sequence="$(git_at show -s --format=%B "$parent" | sed -n -e 's/^Timeline-Sequence: //p' -e 's/^Codex-Timeline-Sequence: //p' | tail -n 1)"
  if [[ "$last_sequence" =~ ^[0-9]+$ ]]; then
    count="$((last_sequence + 1))"
  else
    # A project timeline seeded from ordinary Git history numbers the root
    # commit as #1, so the first recorded snapshot follows the commit count.
    count="$(( $(git_at rev-list --count "$timeline_ref") + 1 ))"
  fi
  subject="${label:-change #$count}"
  commit="$(make_commit "$tree" "$parent" "$subject" "$count")"
  git_at update-ref "$timeline_ref" "$commit" "$parent"
  printf '%s\n' "$commit"
}

resolve_sequence() {
  local wanted="$1" first first_sequence position
  [[ "$wanted" =~ ^[0-9]+$ ]] || die "sequence must be a non-negative integer"
  first="$(git_at rev-list --reverse --topo-order "$timeline_ref" | sed -n '1p')"
  first_sequence="$(git_at show -s --format=%B "$first" | sed -n -e 's/^Timeline-Sequence: //p' -e 's/^Codex-Timeline-Sequence: //p' | tail -n 1)"
  if [[ "$first_sequence" == "0" ]]; then
    position="$((wanted + 1))"
  else
    position="$wanted"
  fi
  [[ "$position" -gt 0 ]] || return
  git_at rev-list --reverse --topo-order "$timeline_ref" | sed -n "${position}p"
}

case "$command_name" in
  sync)
    acquire_lock
    start_timeline
    ;;
  start)
    acquire_lock
    start_timeline
    ;;
  checkpoint)
    acquire_lock
    checkpoint
    ;;
  pending-set)
    acquire_lock
    mkdir -p "$pending_dir"
    printf '%s\n%s\n%s\n%s\n%s\n%s\n' \
      "$(one_line "${label:-Codex tool}")" \
      "$(one_line "$event_name")" \
      "$(one_line "$tool_name")" \
      "$(one_line "$turn_id")" \
      "$(one_line "$tool_use_id")" \
      "$(one_line "${codex_session:-$session}")" > "$pending_file"
    ;;
  flush)
    acquire_lock
    filter_codex_session="$codex_session"
    pending_files=()
    if [[ -n "$tool_use_id" ]]; then
      pending_files=("$pending_file")
    elif [[ -d "$pending_dir" ]]; then
      while IFS= read -r file; do pending_files+=("$file"); done < <(find "$pending_dir" -maxdepth 1 -type f -print | sort)
    fi
    for file in "${pending_files[@]}"; do
      if [[ -f "$file" ]]; then
        pending_codex_session="$(sed -n '6p' "$file")"
        if [[ -n "$filter_codex_session" && "$pending_codex_session" != "$filter_codex_session" ]]; then
          continue
        fi
        IFS= read -r label < "$file" || true
        event_name="$(sed -n '2p' "$file")"
        tool_name="$(sed -n '3p' "$file")"
        turn_id="$(sed -n '4p' "$file")"
        tool_use_id="$(sed -n '5p' "$file")"
        codex_session="$(sed -n '6p' "$file")"
        checkpoint
        rm -f "$file"
      fi
    done
    rmdir "$pending_dir" 2>/dev/null || true
    ;;
  clear-pending)
    acquire_lock
    if [[ -n "$tool_use_id" ]]; then
      rm -f "$pending_file"
    elif [[ -d "$pending_dir" ]]; then
      find "$pending_dir" -maxdepth 1 -type f -delete
    fi
    rmdir "$pending_dir" 2>/dev/null || true
    ;;
  enable)
    git_at config --local codex.timeline.enabled true
    printf 'enabled\n'
    ;;
  disable)
    git_at config --local codex.timeline.enabled false
    printf 'disabled\n'
    ;;
  status)
    if [[ "$(git_at config --bool --get codex.timeline.enabled 2>/dev/null || true)" == "false" ]]; then
      printf 'disabled\n'
    else
      printf 'enabled\n'
    fi
    ;;
  sessions)
    git_at for-each-ref --sort=-committerdate --format='%(refname)%09%(committerdate:iso-strict)%09%(subject)' refs/codex-timeline/
    ;;
  list)
    git_at show-ref --verify --quiet "$timeline_ref" || die "timeline does not exist: $session"
    git_at log --reverse --topo-order --date=iso-strict --format='%H%x09%P%x09%aI%x09%s' "$timeline_ref"
    ;;
  diff)
    [[ -n "$sequence_arg" ]] || die "diff requires a sequence"
    commit="$(resolve_sequence "$sequence_arg")"
    [[ -n "$commit" ]] || die "unknown sequence: $sequence_arg"
    parent="$(git_at rev-parse --verify "$commit^" 2>/dev/null || true)"
    if [[ -n "$parent" ]]; then
      git_at diff --no-ext-diff --minimal "$parent" "$commit" --
    else
      git_at show --format= --no-ext-diff "$commit" --
    fi
    ;;
  files)
    [[ -n "$sequence_arg" ]] || die "files requires a sequence"
    commit="$(resolve_sequence "$sequence_arg")"
    [[ -n "$commit" ]] || die "unknown sequence: $sequence_arg"
    parent="$(git_at rev-parse --verify "$commit^" 2>/dev/null || true)"
    if [[ -n "$parent" ]]; then
      git_at diff --name-only "$parent" "$commit" --
    else
      git_at show --format= --name-only "$commit" --
    fi
    ;;
  context)
    [[ -n "$sequence_arg" ]] || die "context requires a sequence"
    commit="$(resolve_sequence "$sequence_arg")"
    [[ -n "$commit" ]] || die "unknown sequence: $sequence_arg"
    git_at show -s --format='%B' "$commit"
    ;;
  latest)
    git_at for-each-ref --sort=-committerdate --count=1 --format='%(refname)' refs/codex-timeline/
    ;;
  help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $command_name"
    ;;
esac
